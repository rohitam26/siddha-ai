# Environment Variables for Siddha AI

ENVIRONMENT=production
DEBUG=false
PORT=8000
HOST=0.0.0.0

# CORS Allowed Origins (Comma separated in production if needed)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Database URL (Defaults to persistent local SQLite)
DATABASE_URL=sqlite:///./siddha_ai.db

# ML Artifacts
ML_MODEL_PATH=./ml/model_bundle.joblib
ML_METADATA_PATH=./ml/metadata.json
